rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdminClaim() {
      return request.auth != null && (
        (
          request.auth.token.keys().hasAll(['admin']) &&
          request.auth.token.admin == true
        ) ||
        (
          request.auth.token.keys().hasAll(['superAdmin']) &&
          request.auth.token.superAdmin == true
        )
      );
    }

    function hasStrongAdminAuth() {
      return request.auth != null && (
        (
          request.auth.token.keys().hasAll(['firebase']) &&
          request.auth.token.firebase.sign_in_provider == 'google.com'
        ) ||
        (
          request.auth.token.keys().hasAll(['authMethod', 'authAssurance', 'userVerified']) &&
          request.auth.token.authMethod == 'passkey' &&
          request.auth.token.authAssurance == 'aal2' &&
          request.auth.token.userVerified == true
        )
      );
    }

    function hasActiveAdminAccess() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/sys_admin_access/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/sys_admin_access/$(request.auth.uid)).data.active == true;
    }

    function isValidImageWrite() {
      return request.resource != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)');
    }

    function isValidAdminImageWrite() {
      return isAdminClaim()
        && hasStrongAdminAuth()
        && hasActiveAdminAccess()
        && isValidImageWrite();
    }

    match /catalog-projection/{allPaths=**} {
      allow read, write: if false;
    }

    match /commerce-documents/{allPaths=**} {
      allow read, write: if false;
    }

    match /admin-invoices/{allPaths=**} {
      allow read, write: if false;
    }

    match /quote-requests/{allPaths=**} {
      allow read, write: if false;
    }

    match /furniture/publication-sessions/{sessionId}/originals/{slotId}/{fileName} {
      allow read, delete: if false;
      allow create, update: if isAdminClaim()
        && hasStrongAdminAuth()
        && hasActiveAdminAccess()
        && isValidImageWrite()
        && slotId.matches('slot-[0-9][0-9]')
        && fileName.matches('[A-Za-z0-9._-]{1,90}')
        && firestore.exists(/databases/(default)/documents/product_publication_sessions/$(sessionId))
        && firestore.get(/databases/(default)/documents/product_publication_sessions/$(sessionId)).data.ownerUid == request.auth.uid
        && slotId in firestore.get(/databases/(default)/documents/product_publication_sessions/$(sessionId)).data.allowedSlots
        && firestore.get(/databases/(default)/documents/product_publication_sessions/$(sessionId)).data.status in ['uploading', 'processing', 'failed'];
    }

    match /furniture/publication-sessions/{sessionId}/variants/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /furniture/{fileName} {
      allow read: if true;
      allow create, update: if isValidAdminImageWrite();
      allow delete: if false;
    }

    match /furniture/thumbnails/{allPaths=**} {
      allow read: if true;
      allow create, update: if isValidAdminImageWrite();
      allow delete: if false;
    }

    match /furniture/responsive/{allPaths=**} {
      allow read: if true;
      allow create, update: if isValidAdminImageWrite();
      allow delete: if false;
    }

    // Public showcase media is explicit. New top-level folders are private by
    // default and cannot silently become readable when a feature is added.
    match /{publicRoot}/{allPaths=**} {
      allow read: if publicRoot in ['gallery', 'homepage'];
      allow create, update: if publicRoot in ['gallery', 'homepage']
        && isValidAdminImageWrite();
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
