rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /catalog-projection/{allPaths=**} {
      allow read, write: if false;
    }

    match /{topLevel}/{allPaths=**} {
      allow read: if topLevel != 'catalog-projection';
      
      // BLINDAGE ADMINISTRATEUR (Standard & Robuste)
      // Seul l'admin identifié peut uploader. 
      // On bloque les fichiers trop gros (>10Mo), les non-images et les SVG executables.
      allow create, update: if topLevel != 'catalog-projection'
        && request.auth != null
        && (
          request.auth.token.admin == true ||
          request.auth.token.superAdmin == true
        )
        && (
          request.auth.token.firebase.sign_in_provider == 'google.com' ||
          (
            request.auth.token.authMethod == 'passkey' &&
            request.auth.token.authAssurance == 'aal2' &&
            request.auth.token.userVerified == true
          )
        )
        && (
          request.resource == null ||
          (
            request.resource.size < 10 * 1024 * 1024 &&
            request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)')
          )
        );
      allow delete: if false;
    }
  }
}
