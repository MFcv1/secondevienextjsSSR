{
  "name": "secondevie-nextjs-ssr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/with-env.mjs .env.sandbox next dev",
    "dev:host": "node scripts/with-env.mjs .env.sandbox next dev -H 0.0.0.0",
    "dev:host:auto": "node scripts/with-env.mjs .env.sandbox next dev -H 0.0.0.0 -p auto",
    "dev:prod": "node scripts/with-env.mjs .env.production next dev",
    "build": "node scripts/with-env.mjs .env.sandbox next build",
    "build:prod": "node scripts/with-env.mjs .env.production next build",
    "start": "node scripts/with-env.mjs .env.sandbox next start",
    "start:prod": "node scripts/with-env.mjs .env.production next start",
    "dashboard": "node deploy/dashboard.mjs",
    "infra:env": "node scripts/audit-infra-env.cjs",
    "auth:phase0:audit": "node scripts/audit-auth-phase0.cjs",
    "infra:deploy": "node scripts/audit-infra-deploy.cjs",
    "appcheck:audit": "node scripts/audit-app-check-paths.cjs",
    "e2e:auth-email": "node scripts/e2e-auth-email-otp.mjs",
    "e2e:hosted-stripe": "node scripts/e2e-hosted-stripe-checkout.mjs",
    "e2e:refund-stripe": "node scripts/with-env.mjs .env.sandbox node scripts/e2e-refund-latest-stripe-order.mjs",
    "maintenance:audit": "node scripts/maintenance-audit.mjs",
    "lint": "eslint .",
    "lint:functions": "eslint \"functions/src/commerce/**/*.{js,cjs,mjs}\" \"functions/src/email/**/*.{js,cjs,mjs}\" \"functions/src/maintenance/**/*.{js,cjs,mjs}\" \"src/kit/commerce/checkoutController.js\" \"src/kit/commerce/orderAdapter.js\" \"src/kit/commerce/checkoutRecovery.js\" \"tests/commerce/**/*.cjs\" --max-warnings 0",
    "test:commerce:runner": "node --test tests/commerce/runner-self-test.cjs",
    "test:commerce:containment": "node tests/commerce/runner/cli.cjs --manifest tests/commerce/manifest.json --suite containment",
    "test:commerce:rules:containment": "node tests/commerce/run-rules-containment.cjs",
    "test:commerce:unit": "node --require ./tests/commerce/helpers/no-network.cjs --test tests/commerce/domain/order-state.test.cjs tests/commerce/domain/gate2-policy-inventory.test.cjs tests/commerce/domain/compatibility.test.cjs tests/commerce/domain/regression-matrix.test.cjs",
    "test:commerce:property": "node --require ./tests/commerce/helpers/no-network.cjs --test tests/commerce/domain/property.test.cjs",
    "test:commerce:firebase": "node tests/commerce/run-rules-containment.cjs --suite firebase-domain",
    "test:commerce:rules": "node tests/commerce/run-rules-containment.cjs --suite rules-v2",
    "test:commerce:faults": "node --require ./tests/commerce/helpers/no-network.cjs --test tests/commerce/faults/idempotency.test.cjs tests/commerce/faults/gate3-saga.test.cjs tests/commerce/faults/gate3-workers.test.cjs",
    "test:commerce": "pnpm run test:commerce:runner && pnpm run test:commerce:containment && pnpm run test:commerce:unit && pnpm run test:commerce:property && pnpm run test:commerce:faults && pnpm run test:commerce:rules:containment && pnpm run test:commerce:firebase && pnpm run test:commerce:rules",
    "test:analytics": "node scripts/verify-analytics-reliability.mjs",
    "test:deployment-cache": "node --test tests/deployment-cache-contract.test.mjs",
    "test:billing-onboarding": "node --test tests/billing-onboarding-contract.test.cjs",
    "test:catalog": "pnpm run test:catalog:core && pnpm run test:catalog:resilience && pnpm run test:catalog:security",
    "test:catalog:core": "node --test tests/catalog/core.test.cjs",
    "test:catalog:resilience": "node --test tests/catalog/resilience.test.cjs",
    "test:catalog:security": "node --test tests/catalog/security.test.cjs && firebase emulators:exec --config firebase.json --project demo-secondevie-catalog --only firestore,storage \"node --test tests/catalog/emulator/firestore-rules.test.cjs tests/catalog/emulator/storage-rules.test.cjs\"",
    "test:functions:auth": "node tests/auth-claims.test.cjs",
    "test:auth-store": "node --test tests/auth-store-contract.test.cjs",
    "test:passkey-portability": "node --test tests/passkey-portability-contract.test.cjs",
    "test:passkey-server": "node --test tests/passkey-server-hardening.test.cjs",
    "test:auth-unified-otp": "node --test tests/auth-unified-otp-contract.test.cjs",
    "test:auth": "node --test tests/auth-claims.test.cjs tests/auth-store-contract.test.cjs tests/auth-unified-otp-contract.test.cjs tests/auth-backend-transitions.test.cjs tests/auth-admin-revocation.test.cjs tests/auth-assurance.test.cjs tests/auth-region-convergence.test.cjs tests/auth-email-provider-adapter.test.cjs tests/passkey-portability-contract.test.cjs tests/passkey-server-hardening.test.cjs",
    "test:e2e": "playwright test",
    "seo:check": "node scripts/with-env.mjs .env.sandbox node scripts/check-product-ssr.mjs",
    "seo:surface": "node scripts/check-seo-indexability.cjs",
    "images:audit": "node scripts/backfill-product-image-metadata.cjs --dry-run --published-only --env=sandbox && node scripts/backfill-product-image-variants.cjs --dry-run --published-only --env=sandbox && node scripts/audit-storage-orphans.cjs --dry-run --env=sandbox",
    "images:metadata:dry": "node scripts/backfill-product-image-metadata.cjs --dry-run --published-only --env=sandbox",
    "images:variants:dry": "node scripts/backfill-product-image-variants.cjs --dry-run --published-only --env=sandbox",
    "images:detail-fast:dry": "node scripts/backfill-product-image-detail-fast.cjs --dry-run --published-only --env=sandbox",
    "images:detail-fast:commit": "node scripts/backfill-product-image-detail-fast.cjs --commit --confirm=DETAIL_FAST --published-only --env=sandbox",
    "images:card-thumbs:dry": "node scripts/backfill-product-image-card-thumbs.cjs --dry-run --published-only --env=sandbox",
    "images:card-thumbs:commit": "node scripts/backfill-product-image-card-thumbs.cjs --commit --confirm=CARD_THUMBS --published-only --env=sandbox",
    "images:orphans:dry": "node scripts/audit-storage-orphans.cjs --dry-run --env=sandbox",
    "perf:budget": "node scripts/check-performance-budget.cjs",
    "perf:auth:ui": "node scripts/benchmark-auth-ui.mjs --iterations=30",
    "auth:preprod:browsers": "node scripts/audit-auth-preprod-browsers.mjs",
    "perf:scroll": "node scripts/audit-gallery-scroll-lag.mjs --mode=immediate --assert --trace=false",
    "perf:scroll:newsletter": "node scripts/audit-gallery-scroll-lag.mjs --mode=newsletter --assert --trace=false",
    "perf:scroll:cold-sections": "node scripts/audit-gallery-scroll-lag.mjs --mode=cold-sections --assert --trace=false",
    "perf:product-direct": "node scripts/audit-product-page-direct.mjs --assert",
    "perf:category-direct": "node scripts/audit-category-direct.mjs --assert",
    "perf:about-direct": "node scripts/audit-about-direct.mjs --assert",
    "perf:quote-direct": "node scripts/audit-quote-direct.mjs --assert",
    "perf:gallery-direct": "node scripts/audit-gallery-direct.mjs --assert",
    "perf:menu-desktop": "node scripts/audit-desktop-global-menu.mjs --assert",
    "perf:menu-mobile": "node scripts/audit-mobile-global-menu.mjs --assert",
    "perf:product-images": "node scripts/audit-product-detail-images.mjs --assert",
    "perf:product-images:cold": "node scripts/with-env.mjs .env.sandbox node scripts/audit-product-detail-images-cold.mjs",
    "next:routes": "node scripts/check-next-route-classification.cjs",
    "mobile:contract": "node scripts/check-mobile-marketplace-contract.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.9.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/postcss": "^4.1.18",
    "firebase": "^11.1.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.12.5",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.468.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-easy-crop": "^5.5.6",
    "split-type": "^0.3.4"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "4.0.1",
    "@next/eslint-plugin-next": "^15.5.20",
    "@playwright/test": "^1.60.0",
    "chalk": "^5.3.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "firebase-functions": "7.2.5",
    "firebase-tools": "15.23.0",
    "globals": "^14.0.0",
    "inquirer": "^9.3.7",
    "ora": "^8.1.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18"
  }
}
