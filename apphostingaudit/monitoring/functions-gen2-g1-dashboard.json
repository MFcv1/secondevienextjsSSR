{
  "displayName": "Seconde Vie Sandbox - Functions Gen2 G1",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 12,
        "height": 2,
        "widget": {
          "title": "Gate G1",
          "text": {
            "content": "Dashboard sandbox uniquement. Runbooks: apphostingaudit/runbooks/G1_OPERATIONS.md. Toute santé stale, tout incident financier primaire et tout run worker incomplet sont fail-closed.",
            "format": "MARKDOWN"
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 2,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Erreurs Functions Gen1",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"cloudfunctions.googleapis.com/function/execution_count\" resource.type=\"cloud_function\" metric.label.\"status\"!=\"ok\"",
                  "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE" }
                }
              },
              "plotType": "LINE"
            }],
            "yAxis": { "label": "erreurs/s", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 2,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Cloud Run Gen2 5xx",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" metric.label.\"response_code_class\"=\"5xx\"",
                  "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE" }
                }
              },
              "plotType": "LINE"
            }],
            "yAxis": { "label": "5xx/s", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 6,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Cloud Tasks depth",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"cloudtasks.googleapis.com/queue/depth\" resource.type=\"cloud_tasks_queue\"",
                  "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_MAX" }
                }
              },
              "plotType": "LINE"
            }],
            "yAxis": { "label": "taches", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 6,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Workers incomplets",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/secondevie_commerce_worker_incomplete\" resource.type=\"cloud_function\"",
                  "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE" }
                }
              },
              "plotType": "STACKED_BAR"
            }],
            "yAxis": { "label": "runs/s", "scale": "LINEAR" }
          }
        }
      }
    ]
  }
}
