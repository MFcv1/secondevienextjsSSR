{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "main"
    }
  ],
  "apphosting": [
    {
      "backendId": "secondevie-next-sandbox",
      "rootDir": ".",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        ".env*",
        "**/.env*",
        "service-account.json",
        "**/service-account.json",
        "*.pem",
        "**/*.pem",
        "*.key",
        "**/*.key",
        "dist",
        "logs",
        "/docs",
        "/_DOCS",
        "/imagediag",
        "/imageexport",
        "/imagehero",
        "/imageproduit",
        "/pageUI",
        "/video",
        "/videohero",
        "test-results",
        "playwright-report",
        "functions",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.md"
      ],
      "alwaysDeployFromSource": true
    }
  ],
  "emulators": {
    "singleProjectMode": true,
    "functions": { "host": "127.0.0.1", "port": 5001 },
    "firestore": { "host": "127.0.0.1", "port": 8080 },
    "storage": { "host": "127.0.0.1", "port": 9199 },
    "ui": { "enabled": false }
  }
}
