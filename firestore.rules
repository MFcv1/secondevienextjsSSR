rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fonction Admin SECURISEE - Custom Claim Firebase Auth requis.
    function isArtisan() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.superAdmin == true
      );
    }

    function hasActiveAdminAccess() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/sys_admin_access/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/sys_admin_access/$(request.auth.uid)).data.active == true;
    }

    // Fonction Validation User (Basic)
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isPublicMetadataDoc(docId) {
      return docId in [
        'contact_info',
        'delivery',
        'gallery_app',
        'homepage_images',
        'payment_settings',
        'theme_settings'
      ];
    }

    // AAL2: Google selon la politique operationnelle du projet, ou passkey
    // dont la verification locale (PIN/biometrie) a ete attestee par le serveur.
    function hasStrongAuth() {
      return request.auth != null && (
        request.auth.token.firebase.sign_in_provider == 'google.com' ||
        (
          request.auth.token.authMethod == 'passkey' &&
          request.auth.token.authAssurance == 'aal2' &&
          request.auth.token.userVerified == true
        )
      );
    }

    function isStrongArtisan() {
      return isArtisan() && hasStrongAuth() && hasActiveAdminAccess();
    }

    function isProtectedMetadataDoc(docId) {
      return docId in [
        'stripe_connect',
        'delivery',
        'payment_settings'
      ];
    }

    function productCommerceFieldsAreUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'stock', 'sold', 'soldAt', 'buyerId', 'status',
        'currentPrice', 'startingPrice', 'price', 'priceOnRequest',
        'inventoryVersion', 'disponibilite', 'provenanceVente',
        'stockReserved', 'reservation', 'reservations'
      ]);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isStrongArtisan();
      // Le profil, les roles et securityData sont materialises par les Functions.
      // Aucun client, y compris admin, ne doit modifier le document racine.
      allow create, update, delete: if false;
    }

    // Validation Helpers
    function isValidProduct() {
      let data = request.resource.data;
      return
        data.name is string && data.name.size() > 0 && data.name.size() < 140 &&
        data.description is string && data.description.size() < 10000 &&
        (!("currentPrice" in data) || (data.currentPrice is number && data.currentPrice >= 0)) &&
        (!("startingPrice" in data) || (data.startingPrice is number && data.startingPrice >= 0)) &&
        (data.images is list) &&
        (!("thumbnails" in data) || data.thumbnails is list);
    }

    // Collections produits (furniture, cutting_boards, etc.)
    match /artifacts/{appId}/public/data/{collectionName}/{itemId} {
      allow read: if isStrongArtisan();
      allow create, delete: if false;
      allow update: if isStrongArtisan() && isValidProduct() && productCommerceFieldsAreUnchanged();

    }

    // Newsletter Subscribers
    match /newsletter_subscribers/{docId} {
      allow create: if false; // Via Cloud Function uniquement
      allow read: if isStrongArtisan();
      allow update, delete: if isStrongArtisan();
    }

    // Tirages et codes promotionnels: lecture/ecriture uniquement via Functions.
    // L'espace client recoit une projection bornee par callable apres verification
    // de l'adresse e-mail authentifiee.
    match /newsletter_reward_plays/{docId} {
      allow read, write: if false;
    }

    match /newsletter_rewards/{docId} {
      allow read, write: if false;
    }

    // Definitions, compteurs et redemptions promotionnels: Functions uniquement.
    match /commerce_promotion_codes/{codeHash} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Fonction Validation Cart
    function isValidCartItem() {
      let data = request.resource.data;
      return
        data.keys().hasOnly([
          'originalId',
          'collectionName',
          'name',
          'price',
          'stock',
          'sold',
          'priceOnRequest',
          'image',
          'material',
          'quantity',
          'cartLineId',
          'cartRevision',
          'addedAt',
          'updatedAt'
        ]) &&
        (data.quantity is number && data.quantity > 0) &&
        (data.price is number && data.price >= 0) &&
        (!('originalId' in data) || data.originalId is string) &&
        (!('collectionName' in data) || data.collectionName is string) &&
        (!('name' in data) || data.name is string) &&
        (!('stock' in data) || data.stock is number) &&
        (!('sold' in data) || data.sold is bool) &&
        (!('priceOnRequest' in data) || data.priceOnRequest is bool) &&
        (!('image' in data) || data.image is string) &&
        (!('material' in data) || data.material is string) &&
        (!('cartLineId' in data) || data.cartLineId is string) &&
        (!('cartRevision' in data) || (data.cartRevision is int && data.cartRevision >= 0)) &&
        (!('addedAt' in data) || data.addedAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidWishlistItem(wishlistItem) {
      let data = request.resource.data;
      return
        data.keys().hasOnly([
          'originalId',
          'id',
          'collectionName',
          'name',
          'title',
          'price',
          'currentPrice',
          'startingPrice',
          'image',
          'imageUrl',
          'material',
          'addedAt'
        ]) &&
        data.keys().hasAll(['originalId', 'addedAt']) &&
        data.originalId is string &&
        data.originalId == wishlistItem &&
        data.originalId.size() > 0 &&
        data.originalId.size() <= 160 &&
        data.addedAt is timestamp &&
        (!('id' in data) || (data.id is string && data.id == wishlistItem)) &&
        (!('collectionName' in data) || data.collectionName == 'furniture') &&
        (!('name' in data) || (data.name is string && data.name.size() <= 280)) &&
        (!('title' in data) || (data.title is string && data.title.size() <= 280)) &&
        (!('price' in data) || (data.price is number && data.price >= 0 && data.price <= 10000000)) &&
        (!('currentPrice' in data) || (data.currentPrice is number && data.currentPrice >= 0 && data.currentPrice <= 10000000)) &&
        (!('startingPrice' in data) || (data.startingPrice is number && data.startingPrice >= 0 && data.startingPrice <= 10000000)) &&
        (!('image' in data) || (data.image is string && data.image.size() <= 2048)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2048)) &&
        (!('material' in data) || (data.material is string && data.material.size() <= 180));
    }

    // Panier utilisateur
    match /users/{userId}/cart/{cartItem} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId && (isValidCartItem() || request.method == 'delete');
    }

    // Wishlist utilisateur
    match /users/{userId}/wishlist/{wishlistItem} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        isValidWishlistItem(wishlistItem);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Commandes
    match /orders/{orderId} {
      allow read: if isStrongArtisan();
      // L'UID materialise lors du checkout est l'unique identite client.
      // Une adresse e-mail identique ne donne jamais acces a une commande.
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if false; // Via Cloud Function uniquement
      allow update, delete: if false;

      match /payment_attempts/{attemptId} {
        allow read, write: if false;
      }

      match /refunds/{refundId} {
        allow read, write: if false;
      }

      match /returns/{returnId} {
        allow read, write: if false;
      }

      match /customer_return_requests/{requestId} {
        allow read, write: if false;
      }

      match /fulfillments/{fulfillmentId} {
        allow read, write: if false;
      }

      match /events/{eventId} {
        allow read, write: if false;
      }

      match /documents/{documentId} {
        allow read: if isStrongArtisan() || (
          request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/orders/$(orderId)).data.userId
        );
        allow write: if false;
      }
    }

    match /inventory_reservations/{reservationId} {
      allow read, write: if false;
    }

    match /inventory_movements/{movementId} {
      allow read, write: if false;
    }

    match /commerce_webhook_inbox/{inboxId} {
      allow read, write: if false;
    }

    match /commerce_outbox/{outboxId} {
      allow read, write: if false;
    }

    match /commerce_incidents/{incidentId} {
      allow read, write: if false;
    }

    match /commerce_financial_facts/{factId} {
      allow read, write: if false;
    }

    match /commerce_financial_projections/{projectionId} {
      allow read, write: if false;
    }

    match /commerce_financial_totals/{currency} {
      allow read, write: if false;
    }

    match /commerce_financial_daily/{dayId} {
      allow read, write: if false;
    }

    match /commerce_release_manifests/{manifestId} {
      allow read, write: if false;
    }

    match /commerce_order_access_tokens/{tokenId} {
      allow read, write: if false;
    }

    match /commerce_checkout_identities/{identityId} {
      allow read, write: if false;
    }

    match /commerce_connect_accounts/{accountId} {
      allow read, write: if false;
    }

    match /commerce_return_allocations/{allocationId} {
      allow read, write: if false;
    }

    match /commerce_fixture_scopes/{scopeId} {
      allow read, write: if false;
    }

    match /commerce_policy_versions/{policyVersion} {
      allow read, write: if false;
    }

    match /commerce_command_results/{commandId} {
      allow read, write: if false;
    }

    match /commerce_product_audits/{productKey}/events/{eventId} {
      allow read, write: if false;
    }

    // Sessions de publication et etat des traitements image: backend-only.
    match /product_publication_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /sys_commerce_public/{docId} {
      allow read: if docId == 'current';
      allow write: if false;
    }

    match /sys_commerce_operations/{docId} {
      allow read, write: if false;
    }

    // System Metadata
    match /sys_metadata/{docId} {
      allow read: if isStrongArtisan() || isPublicMetadataDoc(docId);
      allow write: if isStrongArtisan() && !isProtectedMetadataDoc(docId);
    }

    // Rate Limiting (Backend-Only)
    match /sys_ratelimit/{docId} {
      allow read, write: if false;
    }

    // Registry d'autorisation admin, exclusivement gere par Firebase Admin SDK.
    match /sys_admin_access/{userId} {
      allow read, write: if false;
    }

    // Compteur materialise des comptes inscrits, maintenu par Auth Functions.
    match /sys_user_stats/{docId} {
      allow read, write: if false;
    }

    // Idempotency Keys (Backend-Only)
    match /sys_idempotency/{docId} {
      allow read, write: if false;
    }

    // Audits internes: ecriture Admin SDK et purge outillee uniquement.
    match /sys_audit_security/{docId} {
      allow read, write: if false;
    }

    match /sys_audit_stripe_connect/{docId} {
      allow read, write: if false;
    }

    match /sys_commerce_control/{docId} {
      allow read, write: if false;
    }

    // Progression du guide de facturation, exclusivement geree par les Functions.
    match /sys_billing_onboarding/{userId} {
      allow read, write: if false;
    }

    // OAuth Meta, jetons chiffrés et sagas de publication: Admin SDK uniquement.
    match /sys_meta_connections/{docId} {
      allow read, write: if false;
    }

    match /sys_meta_oauth_states/{docId} {
      allow read, write: if false;
    }

    match /sys_meta_asset_choices/{docId} {
      allow read, write: if false;
    }

    match /sys_social_publications/{docId} {
      allow read, write: if false;
    }

    match /sys_audit_meta/{docId} {
      allow read, write: if false;
    }

    // Factures manuelles, numerotation et profil emetteur: Functions uniquement.
    match /admin_invoices/{invoiceId} {
      allow read, write: if false;

      match /{subcollection}/{documentId} {
        allow read, write: if false;
      }
    }

    match /admin_invoice_sequences/{year} {
      allow read, write: if false;
    }

    match /admin_business_profiles/{profileId} {
      allow read, write: if false;
    }

    // Demandes de devis, photos et audit: uniquement via les Functions.
    match /quote_requests/{quoteId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /sys_audit_quotes/{auditId} {
      allow read, write: if false;
    }

    // Etat interne du catalogue public materialise. Admin SDK/IAM uniquement.
    match /sys_catalog_publication/{docId} {
      allow read, write: if false;
    }

    match /sys_catalog_publication_events/{docId} {
      allow read, write: if false;
    }

    match /sys_catalog_publication_builds/{docId} {
      allow read, write: if false;
    }

    match /sys_catalog_media_gc/{docId} {
      allow read, write: if false;
    }

    // Signal public minimal de version catalogue. Aucune donnee produit; ecriture backend uniquement.
    match /sys_catalog_live/{docId} {
      allow read: if docId == 'current';
      allow write: if false;
    }

    // Analytics Sessions
    match /analytics_sessions/{docId} {
      allow read: if isStrongArtisan();
      allow write: if false; // Cloud Functions only
    }

    match /sales_stats_daily/{docId} {
      allow read: if isStrongArtisan();
      allow write: if false;
    }

    match /dashboard_stats/{docId} {
      allow read: if isStrongArtisan();
      allow write: if false;
    }

    match /inventory_stats/{docId} {
      allow read: if isStrongArtisan();
      allow write: if false;
    }
  }
}
