+export function getConfirmedCapture(order) {
+    if (order?.payment?.status !== 'succeeded' || order.currency !== 'EUR') return null;
+    const cents = order.amounts?.capturedCents;
+    const timestamp = Date.parse(order.payment.succeededAt);
